local ESPTab = Window:CreateTab("ESP & วาร์ป", 4483362458)
 
local espPlayers = false
local espColorInfected = Color3.fromRGB(255, 50, 50)
local espColorHuman = Color3.fromRGB(50, 255, 50)
 
local function applyESP(v)
    if v == plr then return end
    if v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
        if not v.Character.HumanoidRootPart:FindFirstChild("HighlightESP") then
            local hl = Instance.new("Highlight")
            hl.Name = "HighlightESP"
            hl.Adornee = v.Character
            hl.FillTransparency = 0.5
            hl.OutlineTransparency = 0
            
            if v.Character:FindFirstChild("Infected") then
                hl.FillColor = espColorInfected
            else
                hl.FillColor = espColorHuman
            end
            
            hl.Parent = v.Character.HumanoidRootPart
        end
    end
end
 
