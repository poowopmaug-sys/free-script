local FlyTab = Window:CreateTab("การบิน / เคลื่อนที่", 4483362458)

local flyingMaster = false  -- สวิตช์หลักจาก UI ด้านใน
local flyActive = false      -- สถานะการบินจริง
local flySpeed = 50
local flyConnection = nil

local bv = nil
local bg = nil

-- ตัวแปรปุ่มบินลอยด้านนอก (External Fly Button)
local flyBtnGui = nil
local externalFlyBtn = nil

-- ฟังก์ชั่นลบปุ่มบินลอยด้านนอก
local function destroyExternalFlyBtn()
    if flyBtnGui then
        flyBtnGui:Destroy()
        flyBtnGui = nil
        externalFlyBtn = nil
    end
end

-- ฟังก์ชั่นหยุดการบิน
local function stopFlyingProcess()
    flyActive = false
    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    
    if plr.Character then
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
        
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
        end
    end
end

-- ฟังก์ชั่นเริ่มการบินต้านแรงโน้มถ่วง 100% (นิ่งสนิท ไม่ตก ไม่ไหล)
local function startFlyingProcess()
    stopFlyingProcess()
    flyActive = true

    local char = plr.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    local camera = workspace.CurrentCamera

    if hum then hum.PlatformStand = true end

    -- ตัวสร้างแรงต้าน Gravity 100% ล็อกแกน Y ไม่ให้ไหลตกเด็ดขาด
    bv = Instance.new("BodyVelocity")
    bv.Name = "AntiGravityFlyBV"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    bg = Instance.new("BodyGyro")
    bg.Name = "AntiGravityFlyBG"
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 9e4
    bg.CFrame = camera.CFrame
    bg.Parent = hrp

    flyConnection = game:GetService("RunService").RenderStepped:Connect(function()
        if not flyActive or not hrp or not hrp.Parent then
            stopFlyingProcess()
            return
        end

        bg.CFrame = camera.CFrame

        local moveDir = hum and hum.MoveDirection or Vector3.zero

        if moveDir.Magnitude > 0 then
            local camCF = camera.CFrame
            local localMove = camCF:VectorToObjectSpace(moveDir)
            local flyVector = (camCF.LookVector * -localMove.Z) + (camCF.RightVector * localMove.X)

            if flyVector.Magnitude > 0 then
                bv.Velocity = flyVector.Unit * flySpeed
            else
                bv.Velocity = Vector3.zero
            end
        else
            -- ล็อกนิ่งสนิท แรง Y = 0 ป้องกันการตก 100%
            bv.Velocity = Vector3.zero
        end
    end)
end

-- ฟังก์ชั่นสร้างปุ่มบินลอยด้านนอก (External Fly Button)
local function createExternalFlyBtn()
    destroyExternalFlyBtn()

    flyBtnGui = Instance.new("ScreenGui")
    flyBtnGui.Name = "ExternalFlyGui"
    flyBtnGui.ResetOnSpawn = false
    
    if game:GetService("CoreGui"):FindFirstChild("ExternalFlyGui") then
        game:GetService("CoreGui").ExternalFlyGui:Destroy()
    end
    flyBtnGui.Parent = game:GetService("CoreGui")

    externalFlyBtn = Instance.new("TextButton")
    externalFlyBtn.Name = "FlyToggleBtn"
    externalFlyBtn.Size = UDim2.new(0, 65, 0, 65)
    externalFlyBtn.Position = UDim2.new(0, 15, 0.5, -30)
    externalFlyBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50) -- สีแดง = ปิดบินอยู่
    externalFlyBtn.Text = "FLY: OFF"
    externalFlyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    externalFlyBtn.Font = Enum.Font.GothamBold
    externalFlyBtn.TextSize = 13
    externalFlyBtn.Active = true
    externalFlyBtn.Draggable = true
    externalFlyBtn.Parent = flyBtnGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = externalFlyBtn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Thickness = 2
    stroke.Parent = externalFlyBtn

    -- กิจกรรมเมื่อกดปุ่มบินด้านนอก
    externalFlyBtn.MouseButton1Click:Connect(function()
        if not flyingMaster then return end

        if flyActive then
            stopFlyingProcess()
            externalFlyBtn.Text = "FLY: OFF"
            externalFlyBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
        else
            startFlyingProcess()
            externalFlyBtn.Text = "FLY: ON"
            externalFlyBtn.BackgroundColor3 = Color3.fromRGB(40, 200, 80)
        end
    end)
end

